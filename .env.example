# Host-only path used by Docker Compose. Copy this file to .env.
SOCIAL_MEDIA_HOST_PATH=/Users/kevintame/Vaults/Second Brain/02 Areas/Social Media
HOST_UID=501
HOST_GID=20

# Browser and container endpoints for the local Supabase CLI stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-output-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-output-from-supabase-status
SOCIAL_MEDIA_ROOT=/workspace/social-media
MAX_IMAGE_BYTES=26214400
MAX_VIDEO_BYTES=262144000

# Local-only seeded credentials. Change these in .env before db reset.
LOCAL_KEVIN_EMAIL=kevin@example.test
LOCAL_KEVIN_PASSWORD=local-kevin-change-me
LOCAL_MANAGER_EMAIL=manager@example.test
LOCAL_MANAGER_PASSWORD=local-manager-change-me

# Local manager API. Generate a high-entropy token; the seeded manager is a
# non-approver. Never configure Kevin's approver UUID here.
HERMES_MANAGER_TOKEN=
HERMES_MANAGER_USER_ID=22222222-2222-4222-8222-222222222222
